# Copy to deploy/.env.production, replace every change-me value, then chmod 600.

# Use lowercase hexadecimal output from: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis

# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-auth-secret

# Generate with: openssl rand -hex 32
CRON_SECRET=change-me-cron-secret

# Initially use the ECS public IP. Replace with https://your-domain after TLS is enabled.
NEXTAUTH_URL=http://203.0.113.10

# Keep the application private behind host Nginx.
WEB_PORT=3000

# This exact absolute path is mounted into web/worker and the judge containers.
JUDGE_TMP_DIR=/var/lib/pylearn/judge-tmp
# Numeric GID of the host Docker group: getent group docker | cut -d: -f3
DOCKER_GID=999
JUDGE_IMAGE=python:3.11-slim
JUDGE_CONCURRENCY=4
JUDGE_TOTAL_TIMEOUT_MS=30000

MAX_UPLOAD_BYTES=104857600
IMAGE_TAG=latest
