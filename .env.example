# ===== 数据库（与 docker-compose.yml 对齐）=====
DATABASE_URL="postgresql://pylearn:pylearn_dev@localhost:5432/pylearn?schema=public"

# ===== 队列 =====
REDIS_URL="redis://localhost:6379"

# ===== 认证 =====
# 用 `openssl rand -base64 32` 生成
AUTH_SECRET="change-me-to-a-32-byte-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ===== 文件存储 =====
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES="104857600" # 100MB · SPEC §2.2

# ===== 评测 =====
# SPEC §3.1 沙箱红线：--network=none --read-only --cap-drop=ALL --pids-limit=64
JUDGE_IMAGE="python:3.11-slim"
JUDGE_CONCURRENCY="6" # SPEC §0 上限
JUDGE_TIMEOUT_MS="3000" # 单测试用例
JUDGE_MEMORY_MB="128"
JUDGE_TOTAL_TIMEOUT_MS="30000" # 单次提交总硬上限
# docker = 生产默认沙箱（per-case container）
# local  = 裸跑 fallback，本地无 Docker 时调试用
JUDGE_BACKEND="docker"

# ===== 定时任务 =====
# 自动交卷 cron 用（SPEC §3.2）。用 `openssl rand -hex 32` 生成。
# Vercel Cron 自动注入；系统 cron / k8s CronJob 用作 Bearer token。
CRON_SECRET="change-me-to-a-random-hex-string"
